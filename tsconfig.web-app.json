{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/main/repositories/**/*.ts",
    "src/main/services/**/*.ts",
    "src/main/db/**/*.ts",
    "src/main/lib/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["src/main/repositories/**/*.test.ts"]
}
